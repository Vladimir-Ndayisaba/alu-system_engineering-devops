#!/usr/bin/env bash
# Configure Nginx with a custom 404 error page

apt-get update -y
apt-get install -y nginx

echo "Ceci n'est pas une page" > /var/www/html/404.html

if ! grep -q "error_page 404 /404.html;" /etc/nginx/sites-available/default; then
    sed -i '/server_name _;/a\    error_page 404 /404.html;' /etc/nginx/sites-available/default
fi

if ! grep -q 'location = /404.html' /etc/nginx/sites-available/default; then
    sed -i '/error_page 404 \/404.html;/a\    location = /404.html { internal; }' /etc/nginx/sites-available/default
fi

nginx -t
service nginx restart

